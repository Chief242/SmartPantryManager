<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="4dp"
    android:background="#FFFFFF">

    <!-- Ingredient Name -->
    <TextView
        android:id="@+id/txtIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="6dp" />

    <!-- Ingredient Quantity -->
    <TextView
        android:id="@+id/txtIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity"
        android:textSize="14sp"
        android:textColor="#626B63"
        android:layout_marginBottom="14dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Edit"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6B50A5"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#B84449"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>