<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Recipe title -->
        <TextView
            android:id="@+id/txtRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#234B35"
            android:lineSpacingExtra="3dp"
            android:includeFontPadding="true"
            android:layout_marginBottom="24dp" />

        <!-- Ingredients heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#234B35"
            android:layout_marginBottom="10dp" />

        <!-- Ingredient card -->
        <TextView
            android:id="@+id/txtRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients"
            android:textSize="16sp"
            android:textColor="#414A43"
            android:lineSpacingExtra="6dp"
            android:padding="18dp"
            android:background="@drawable/bg_recipe_detail_card"
            android:layout_marginBottom="26dp" />

        <!-- Preparation heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#234B35"
            android:layout_marginBottom="10dp" />

        <!-- Preparation instructions card -->
        <TextView
            android:id="@+id/txtRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation instructions"
            android:textSize="16sp"
            android:textColor="#414A43"
            android:lineSpacingExtra="7dp"
            android:padding="18dp"
            android:background="@drawable/bg_recipe_detail_card" />

    </LinearLayout>

</ScrollView>

