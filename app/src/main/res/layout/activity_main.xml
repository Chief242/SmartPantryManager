<?xml version="1.0" encoding="utf-8" ?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id ="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <!-- Welcome icon -->
            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:gravity="center"
                android:text="🥗"
                android:textSize="42sp"
                android:background="@drawable/bg_recipe_detail_card"
                android:layout_marginBottom="18dp"
                android:contentDescription="Healthy food icon" />

            <!-- App title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Smart Pantry Manager"
                android:textSize="27sp"
                android:textStyle="bold"
                android:textColor="#234B35"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:layout_marginBottom="12dp" />

            <!-- Welcome message -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Make delicious meals with the ingredients you already have."
                android:textSize="16sp"
                android:textColor="#626B63"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="30dp" />

            <!-- Navigation label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GET STARTED"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#6B50A5"
                android:letterSpacing="0.12"
                android:layout_marginBottom="14dp" />

            <!-- My Pantry -->
            <Button
                android:id="@+id/btnPantry"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="My Pantry"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="14dp" />

            <!-- Suggested Recipes -->
            <Button
                android:id="@+id/btnRecipes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Suggested Recipes"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:layout_marginBottom="14dp" />

            <!-- Settings -->
            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Settings"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#234B35"
                android:backgroundTint="#E2EBDD"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>






