<?xml version="1.0" encoding="utf-8" ?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="60dp"
    android:paddingBottom="12dp">

    <!-- Screen Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="6dp" />

    <!-- Screen Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage the ingredients you have at home."
        android:textSize="14sp"
        android:textColor="#626B63"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="18dp" />

    <!-- Add Ingredient Button -->
    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="+ Add Ingredient"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6B50A5"
        android:layout_marginBottom = "24dp"
        android:stateListAnimator="@null" />

    <!-- Ingredient List Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Ingredients"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="4dp" />

    <!-- Supporting Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Everything currently in your pantry"
        android:textSize="13sp"
        android:textColor="#737B74"
        android:layout_marginBottom="12dp" />

    <!-- Empty Pantry Message -->
    <TextView
        android:id="@+id/txtEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your pantry is empty.\nAdd ingredients to get started."
        android:textSize="16sp"
        android:textColor="#626B63"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone" />

    <!-- Scrollable Ingredient List -->
    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:clickable="true"/>

    </LinearLayout>
