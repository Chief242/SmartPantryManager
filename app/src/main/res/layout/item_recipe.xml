<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp"
    android:background="#FFFFFF">

    <!-- Recipe Name -->
    <TextView
        android:id="@+id/txtRecipeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recipe Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="6dp" />

    <!-- Number of Required Ingredients -->
    <TextView
        android:id="@+id/txtRecipeIngredientCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3 required ingredients"
        android:textSize="14sp"
        android:textColor="#626B63"
        android:layout_marginBottom="14dp" />

    <!-- View Recipe Button -->
    <Button
        android:id="@+id/btnViewRecipe"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="View Recipe"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6B50A5"
        android:stateListAnimator="@null"/>

</LinearLayout>