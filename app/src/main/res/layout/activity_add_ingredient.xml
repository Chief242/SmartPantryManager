<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F2"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Screen Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Details"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="8dp" />

    <!-- Screen Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add an ingredient to your pantry or update an exisitng one."
        android:textSize="14sp"
        android:textColor="#626B63"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="24dp"/>

    <!-- Ingredient Name Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Name"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="6dp" />

    <!-- Ingredient Name Input -->
    <EditText
        android:id="@+id/edtIngredientName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="e.g. Milk"
        android:inputType="textCapSentences"
        android:singleLine="true"
        android:textSize="16sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:backgroundTint="#6B50A5"
        android:layout_marginBottom="20dp" />

    <!-- Quantity Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quantity"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="6dp" />

    <!-- Quantity Input -->
    <EditText
        android:id="@+id/edtQuantity"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="e.g. 2"
        android:inputType="numberDecimal"
        android:singleLine="true"
        android:textSize="16sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:backgroundTint="#6B50A5"
        android:layout_marginBottom="20dp" />

    <!-- Unit Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unit of Measurement"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="6dp" />

    <!-- Unit Selection -->
    <Spinner
        android:id="@+id/spinnerUnit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:entries="@array/ingredient_units"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:backgroundTint="#6B50A5"
        android:layout_marginBottom="28dp" />

    <!-- Save / Update Button -->
    <Button
        android:id="@+id/btnSaveIngredient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Save Ingredient"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6B50A5"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancelIngredient"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textSize="15dp"
        android:textColor="#234B35"
        android:backgroundTint="#E5EAE2"
        android:stateListAnimator="@null" />


</LinearLayout>

