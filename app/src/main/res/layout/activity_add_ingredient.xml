<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="60dp"
        android:paddingBottom="24dp">

    <!-- Screen Heading -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient Details"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#234B35"
        android:layout_marginBottom="8dp" />

    <!-- Screen Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add an ingredient to your pantry or update an existing one."
        android:textSize="14sp"
        android:textColor="#626B63"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="24dp"/>

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_ingredient_form">

            <!-- Ingredient Name -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredient Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#234B35"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtIngredientName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. Milk"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#234B35"
                android:textColorHint="#8A9389"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_ingredient_input"
                android:layout_marginBottom="22dp" />

            <!-- Quantity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quantity"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#234B35"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edtQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="e.g. 2"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textSize="16sp"
                android:textColor="#234B35"
                android:textColorHint="#8A9389"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_ingredient_input"
                android:layout_marginBottom="22dp" />

            <!-- Unit -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unit of Measurement"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#234B35"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerUnit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:entries="@array/ingredient_units"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/bg_ingredient_input"
                android:layout_marginBottom="26dp" />

            <!-- Save Button -->
            <Button
                android:id="@+id/btnSaveIngredient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save Ingredient"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6B50A5"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp" />

            <!-- Cancel Button -->
            <Button
                android:id="@+id/btnCancelIngredient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="#234B35"
                android:backgroundTint="#E2EBDD"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep your pantry quantities accurate for better recipe suggestions."
            android:layout_marginTop="16dp"
            android:textSize="12sp"
            android:textColor="#737D73"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>



